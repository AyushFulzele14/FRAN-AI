# GEMINI_API_KEY: Required for Gemini AI API calls.

GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.

# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Real Email Delivery Configuration (Optional)
# Configure one of the following to deliver real emails to external mailboxes:
# 1. RESEND_API_KEY (Recommended - from https://resend.com)
RESEND_API_KEY=
# 2. BREVO_API_KEY (from https://brevo.com)
BREVO_API_KEY=
# 3. SENDGRID_API_KEY (from https://sendgrid.com)
SENDGRID_API_KEY=
# 4. Standard SMTP (e.g. Gmail App Password, Mailgun, Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FranAI Notifications <onboarding@resend.dev>"
